    },
    "storage": {
      "port": 28575,
      "host": "0.0.0.0"
    },
    "functions": {
      "port": 28579,
      "host": "0.0.0.0"
    },
    "hosting": {
      "port": 28571,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
